{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUANTAXIS生态图数据",
  "description": "固定研究快照；图数据不是运行验收。JSON Schema校验结构与公开可用性，跨集合引用须另行校验。",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "layers",
    "routes",
    "nodes",
    "edges",
    "repos",
    "events",
    "pdfCapabilities",
    "evidence",
    "glossary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "subtitle",
        "asOf",
        "guideVersion",
        "researchScope",
        "limitations",
        "reportLinks",
        "pdf",
        "publicationNote"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "guideVersion": {},
        "researchScope": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reportLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "additionalProperties": true
          }
        },
        "pdf": {
          "type": "object",
          "required": [
            "title",
            "url",
            "pages"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "pages": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "publicationNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repo"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "pdfCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pdfCapability"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossary"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "required": [
        "source",
        "implementation",
        "wiring",
        "era"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "public",
            "partial",
            "unresolved",
            "concept",
            "external"
          ]
        },
        "implementation": {
          "type": "string",
          "enum": [
            "implemented",
            "partial",
            "placeholder",
            "unknown",
            "concept"
          ]
        },
        "wiring": {
          "type": "string",
          "enum": [
            "entry",
            "library",
            "mixed",
            "external",
            "unknown",
            "concept"
          ]
        },
        "era": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "repoIds",
        "layer",
        "role",
        "why",
        "implementation",
        "boundaries",
        "status",
        "evidenceIds",
        "topics",
        "overview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "repository",
            "concept",
            "external",
            "pointer"
          ]
        },
        "repoIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "role": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "implementation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overview": {
          "type": "boolean"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "label",
        "description",
        "evidenceIds",
        "routeIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "calls",
            "data",
            "protocol",
            "concept",
            "lineage",
            "unresolved"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "title",
        "short",
        "question",
        "summary",
        "nodeIds",
        "edgeIds",
        "steps",
        "limitations",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edgeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nodeId",
              "label",
              "why"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "label": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "repo": {
      "type": "object",
      "required": [
        "id",
        "name",
        "commit",
        "url",
        "role",
        "scope",
        "era",
        "publicState",
        "headChecked",
        "limitations",
        "nodeIds",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "role": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "era": {
          "type": "string"
        },
        "publicState": {
          "type": "string"
        },
        "headChecked": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "date",
        "year",
        "title",
        "summary",
        "meaning",
        "limitations",
        "repoIds",
        "nodeIds",
        "evidenceIds",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "date": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repoIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit": {
          "type": "string"
        },
        "authorDate": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "pdfCapability": {
      "type": "object",
      "required": [
        "id",
        "title",
        "pages",
        "summary",
        "nodeIds",
        "publicFinding",
        "gaps",
        "classification",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 82
          }
        },
        "summary": {
          "type": "string"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicFinding": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "type",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "source",
            "commit",
            "report",
            "pdf",
            "metadata"
          ]
        },
        "repoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "availability": {
          "enum": [
            "public",
            "not_published"
          ]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "not_published"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "type": "null"
              }
            },
            "required": [
              "note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "public"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?:github\\.com|api\\.github\\.com)/"
              }
            }
          }
        }
      ]
    },
    "glossary": {
      "type": "object",
      "required": [
        "term",
        "meaning"
      ],
      "properties": {
        "term": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
